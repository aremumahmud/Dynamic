rules_version = '2';

// Deny all direct client access. Every read and write to blog post data goes
// through Next.js server code (Server Components and /api/admin/* routes)
// using the Firebase Admin SDK, which bypasses these rules entirely. This
// keeps blog content fully server-controlled with no client-side Firestore
// access surface to secure.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
